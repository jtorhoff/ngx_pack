# Either the repository root was added as the module (the top-level
# config sources this, having set ngx_addon_name), or this directory
# was added directly. PACK_ROOT_DIR has to reach the repository root
# either way, since the Brotli submodule lives there rather than
# beside the sources.
#
# The sources are in this same directory: the encoding's name is
# already on the directory, so there is nothing for a further level to
# distinguish. Each encoding is one directory carrying its own config
# and its own sources, which is what lets the two be added
# independently as well as together.
if [ "$ngx_addon_name" = "ngx_pack" ]; then
	PACK_MODULE_SRC_DIR="$ngx_addon_dir/module/filter/brotli"
	PACK_ROOT_DIR="$ngx_addon_dir"
else
	PACK_MODULE_SRC_DIR="$ngx_addon_dir"
	PACK_ROOT_DIR="$ngx_addon_dir/../../.."
fi

ngx_addon_name=ngx_pack_brotli_filter
ngx_module_type=HTTP_FILTER
ngx_module_name=ngx_http_pack_brotli_module

# Vendored rather than taken from the system, for the same reason the
# zstd submodule is: pinning keeps the version the same everywhere
# this builds.
#
# Absolute, by way of PACK_ROOT_DIR: configure runs from the nginx
# tree and writes objs/Makefile there, so a path relative to this file
# would be read relative to nginx/ instead and find nothing.
PACK_BROTLI_DIR="$PACK_ROOT_DIR/deps/brotli/c"
if [ ! -f "$PACK_BROTLI_DIR/include/brotli/encode.h" ]; then
	cat <<END

$0: error: \
Brotli library is missing from the $PACK_BROTLI_DIR directory.

Please make sure that the git submodule has been checked out:

    cd $PACK_ROOT_DIR && git submodule update --init && cd $PWD

END
	exit 1
fi

BROTLI_OUTPUT_DIRECTORY="$PACK_ROOT_DIR/deps/brotli/out"
BROTLI_ENC_H="$PACK_BROTLI_DIR/include/brotli/encode.h \
              $PACK_BROTLI_DIR/include/brotli/port.h \
              $PACK_BROTLI_DIR/include/brotli/types.h"

# Shared with the static module. Listed as a dependency so that
# editing it actually rebuilds this module.
#
# Reached from the repository root rather than from the sources, so
# that the path does not have to change if these sources move.
PACK_COMMON_DIR="$PACK_ROOT_DIR/module/common"
PACK_COMMON_H="$PACK_COMMON_DIR/ngx_http_pack_headers.h"
PACK_HELPERS_H="$PACK_COMMON_DIR/ngx_http_pack_helpers.h"

# The "pack" directive itself: what decides whether this filter is
# listed at all, its rank, and whether it is "=always" - see
# ngx_http_pack_module.h.
PACK_MODULE_H="$PACK_ROOT_DIR/module/pack/ngx_http_pack_module.h"

# The encoder is a translation unit of its own so that the filter
# cannot see inside it: the header declares an incomplete type, and
# only ngx_http_pack_brotli_encoder.c knows what it holds.
PACK_ENCODER_H="$PACK_MODULE_SRC_DIR/ngx_http_pack_brotli_encoder.h"

# The one thing zstd's own filter needs from this module: see
# ngx_http_pack_brotli_filter.h for why.
PACK_FILTER_H="$PACK_MODULE_SRC_DIR/ngx_http_pack_brotli_filter.h"

ngx_module_incs="$PACK_BROTLI_DIR/include"
ngx_module_deps="$BROTLI_ENC_H $PACK_COMMON_H $PACK_HELPERS_H \
$PACK_MODULE_H $PACK_ENCODER_H $PACK_FILTER_H"
ngx_module_srcs="$PACK_MODULE_SRC_DIR/ngx_http_pack_brotli_filter.c \
                 $PACK_MODULE_SRC_DIR/ngx_http_pack_brotli_encoder.c"
# The archives by full path rather than -L plus -l. nginx puts
# --with-ld-opt ahead of a module's own libraries, so on a machine
# whose -L there holds a system Brotli - Homebrew's, say - the linker
# resolves against that and the vendored one is never reached. That
# defeats the whole point of pinning the submodule, and it fails
# silently: the build succeeds, and only otool or ldd shows which copy
# was taken. Naming the files leaves nothing to search for.
#
# Encoder before common: the encoder refers to the common symbols, and
# a static archive only satisfies what is already outstanding.
#
# -lm because Brotli's encoder uses log2() in its cost model.
ngx_module_libs="$BROTLI_OUTPUT_DIRECTORY/libbrotlienc.a \
$BROTLI_OUTPUT_DIRECTORY/libbrotlicommon.a -lm"
# No ngx_module_order. It is read only for a dynamic build -
# auto/module sets ${ngx_module}_ORDER inside its "link = DYNAMIC"
# branch and auto/make reads it back only while walking
# DYNAMIC_MODULES - and this module is shipped to be compiled into
# nginx, never loaded. Declaring one anyway would leave the config
# carrying the mechanism a reader reaches for first when changing
# which filter claims a response, doing nothing: the reordering below
# is what decides that, and script/tests/stream/test_stream.py pins
# the result.

. auto/module

if [ "$ngx_module_link" != DYNAMIC ]; then
	# The only ordering this build has: a static link ignores
	# ngx_module_order, so the filter is moved into place here.

	if [ "$HTTP_GZIP" = YES ]; then
		next=ngx_http_gzip_filter_module
	elif
		echo "$HTTP_FILTER_MODULES" |
			grep pagespeed_etag_filter >/dev/null
	then
		next=ngx_pagespeed_etag_filter
	else
		next=ngx_http_range_header_filter_module
	fi

	HTTP_FILTER_MODULES=$(echo "$HTTP_FILTER_MODULES" |
		sed "s/$ngx_module_name//" |
		sed "s/$next/$next $ngx_module_name/")
fi

CFLAGS="$CFLAGS -Wno-deprecated-declarations"

have=NGX_HTTP_PACK_BROTLI_FILTER_MODULE . auto/have
