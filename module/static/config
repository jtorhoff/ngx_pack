if [ "$ngx_addon_name" = "ngx_zstd" ]; then
  ZSTD_MODULE_SRC_DIR="$ngx_addon_dir/module/static"
else
  ZSTD_MODULE_SRC_DIR="$ngx_addon_dir"
fi

ngx_addon_name=ngx_zstd_static

if [ -z "$ngx_module_link" ]; then
cat << END

$0: error: Zstandard module requires recent version of NGINX (1.9.11+).

END
  exit 1
fi

ngx_module_type=HTTP
ngx_module_incs=
# Shared with the filter module. Listed as a dependency so that
# editing it actually rebuilds this module.
ZSTD_COMMON_DIR="$ZSTD_MODULE_SRC_DIR/../common"
ngx_module_name=ngx_http_zstd_static_module
ngx_module_deps="$ZSTD_COMMON_DIR/ngx_http_zstd_headers.h"
ngx_module_srcs="$ZSTD_MODULE_SRC_DIR/ngx_http_zstd_static_module.c"
ngx_module_libs=
ngx_module_order=

. auto/module

# NGX_HTTP_GZIP is deliberately not redeclared here. nginx's own
# auto/modules already defines it, conditionally, when the gzip
# filter is actually configured in; forcing it on unconditionally -
# which is what ngx_brotli's equivalent config does - would make
# ngx_http_zstd_headers.h's "#if (NGX_HTTP_GZIP)" branch reference
# r->gzip_vary on a build where ngx_http_request_t never declared
# that field, i.e. --without-http_gzip_module. Nobody notices in
# practice because gzip defaults to built-in, which is exactly why
# it is worth not repeating.
have=NGX_HTTP_ZSTD_STATIC_MODULE . auto/have
