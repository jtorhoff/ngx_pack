if [ "$ngx_addon_name" = "ngx_pack" ]; then
	PACK_MODULE_SRC_DIR="$ngx_addon_dir/module/static"
else
	PACK_MODULE_SRC_DIR="$ngx_addon_dir"
fi

ngx_addon_name=ngx_pack_static
ngx_module_type=HTTP
ngx_module_incs=
# Shared with the filter module. Listed as a dependency so that
# editing it actually rebuilds this module.
PACK_COMMON_DIR="$PACK_MODULE_SRC_DIR/../common"
ngx_module_name=ngx_http_pack_static_module
ngx_module_deps="$PACK_COMMON_DIR/ngx_http_pack_headers.h"
ngx_module_srcs="$PACK_MODULE_SRC_DIR/ngx_http_pack_static.c"
ngx_module_libs=
ngx_module_order=

. auto/module

# NGX_HTTP_GZIP is deliberately not redeclared here. nginx's own
# auto/modules already defines it, conditionally, when the gzip
# filter is actually configured in; forcing it on unconditionally -
# which is what ngx_brotli's equivalent config does - would make
# ngx_http_pack_headers.h's "#if (NGX_HTTP_GZIP)" branch reference
# r->gzip_vary on a build where ngx_http_request_t never declared
# that field, i.e. --without-http_gzip_module. Nobody notices in
# practice because gzip defaults to built-in, which is exactly why
# it is worth not repeating.
have=NGX_HTTP_PACK_STATIC_MODULE . auto/have
