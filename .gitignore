# Build trees, none of which belong in the repository.
nginx/
# The nginx trees the purpose-built suites make, each kept apart from
# nginx/ so a binary carrying a stress setting or a test-only module
# cannot be mistaken for the one the normal suites run against.
nginx-small-buffer/
nginx-fault/
nginx-oom/
nginx-coverage/
# And the ones built by hand rather than by a suite: a release
# build for the benchmarks, whose timings a --with-debug binary
# would swamp, and whatever a comparison against another library
# is linked into.
nginx-bench/
nginx-zng/
objs/
objs-dyn/
# Build output from the vendored zstd; the submodule itself is
# tracked.
deps/zstd/out/
script/test/
script/fuzz/out/
__pycache__/
*.o
*.a
.DS_Store

# Editor/LSP configuration pointing at the nginx build tree. nginx
# emits no compile_commands.json, so clangd needs to be told where the
# headers are - but the tree is an untracked build artifact at an
# absolute path, which makes the file machine-specific.
.clangd
compile_commands.json
# Whatever the editor keeps beside them, which is a preference
# rather than a property of the project.
.vscode/

# Artifacts left behind by script/tests/basic/run-tests.sh: response bodies and
# the decompressed copies it compares them against.
tmp/
# Raw and merged profiles from script/build/coverage.sh.
coverage-data/
*.profraw
*.profdata
