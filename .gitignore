# Build trees, none of which belong in the repository.
nginx/
# The second nginx tree script/test-small-buffer.sh builds, kept
# apart from nginx/ so a stress binary cannot be mistaken for the one
# the normal suites run against.
nginx-small-buffer/
objs/
objs-dyn/
# Build output from the vendored zstd; the submodule itself is
# tracked.
deps/zstd/out/
script/test/
script/fuzz/out/
__pycache__/
*.o
*.a
.DS_Store

# Artifacts left behind by script/run-tests.sh: response bodies and
# the decompressed copies it compares them against.
tmp/
